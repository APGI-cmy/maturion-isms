{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maturion.example/governance/schemas/active-cs2-job-wave/v1",
  "title": "Active CS2 Job and Wave Record",
  "description": "Contract-ready record for one approved job containing an arbitrary non-empty collection of explicitly approved waves. Graph acyclicity, dependency order, event ordering, and counter transitions require evaluator validation.",
  "type": "object",
  "required": ["schema_version", "job_id", "status", "approved_scope", "envelope", "waves", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "pattern": "^job-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "status": {"enum": ["PROPOSED", "APPROVED", "ACTIVE", "INTEGRATION_VALIDATION", "COMPLETE", "BLOCKED", "TRIPPED", "ABANDONED"]},
    "current_wave_id": {"type": ["string", "null"], "pattern": "^wave-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "approved_scope": {"type": "object", "required": ["authority_reference", "acceptance_obligations"], "additionalProperties": false, "properties": {"authority_reference": {"type": "string", "minLength": 1}, "acceptance_obligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "envelope": {"$ref": "#/$defs/envelope"},
    "waves": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/wave"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "final_acceptance": {"type": ["object", "null"], "required": ["integrated_fingerprint", "functional_evidence", "regression_evidence", "acceptance_evidence"], "additionalProperties": false, "properties": {"integrated_fingerprint": {"$ref": "#/$defs/fingerprint"}, "functional_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "regression_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}
  },
  "$defs": {
    "fingerprint": {"type": "object", "required": ["repository", "head_sha", "base_sha", "reviewed_content_sha256"], "additionalProperties": false, "properties": {"repository": {"type": "string", "minLength": 1}, "pr": {"type": ["integer", "null"], "minimum": 1}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "reviewed_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "approvedLimit": {"type": ["integer", "null"], "minimum": 0},
    "envelope": {"type": "object", "required": ["envelope_id", "max_active_jobs", "max_active_waves", "max_material_corrections", "max_dispatch_runtime_minutes", "max_total_runtime_minutes", "expiry_at", "stage_attempt_limits", "merge_attempt_limit", "spend_ceiling", "spend_telemetry_mode", "human_reset_required"], "additionalProperties": false, "properties": {"envelope_id": {"type": "string", "minLength": 1}, "max_active_jobs": {"const": 1}, "max_active_waves": {"const": 1}, "max_material_corrections": {"$ref": "#/$defs/approvedLimit"}, "max_dispatch_runtime_minutes": {"type": ["integer", "null"], "minimum": 1}, "max_total_runtime_minutes": {"type": ["integer", "null"], "minimum": 1}, "expiry_at": {"type": ["string", "null"], "format": "date-time"}, "stage_attempt_limits": {"type": ["object", "null"], "additionalProperties": {"type": "integer", "minimum": 1}}, "merge_attempt_limit": {"$ref": "#/$defs/approvedLimit"}, "spend_ceiling": {"type": ["number", "null"], "minimum": 0}, "spend_telemetry_mode": {"enum": ["RUNTIME_ONLY", "RUNTIME_AND_SPEND"]}, "human_reset_required": {"const": true}}},
    "evidenceBinding": {"type": "object", "required": ["frozen_substantive_fingerprint", "evidence_envelope_id", "current_merge_head_sha", "token_only_delta_verified"], "additionalProperties": false, "properties": {"frozen_substantive_fingerprint": {"$ref": "#/$defs/fingerprint"}, "evidence_envelope_id": {"type": "string", "minLength": 1}, "current_merge_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "token_only_delta_verified": {"type": "boolean"}, "permitted_token_append": {"type": ["object", "null"], "required": ["token_path", "token_sha256"], "additionalProperties": false, "properties": {"token_path": {"type": "string", "minLength": 1}, "token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}},
    "wave": {"type": "object", "required": ["wave_id", "ordinal", "status", "depends_on", "scope", "acceptance_obligations"], "additionalProperties": false, "properties": {"wave_id": {"type": "string", "pattern": "^wave-[A-Za-z0-9][A-Za-z0-9._-]*$"}, "ordinal": {"type": "integer", "minimum": 1}, "status": {"enum": ["PLANNED", "ELIGIBLE", "CLAIMED", "DISPATCHED", "IN_BUILD", "IN_ASSURANCE", "IN_REVIEW", "MERGE_ELIGIBLE", "MERGED", "VALIDATED", "CORRECTION", "BLOCKED", "FAILED", "ABANDONED", "TRIPPED"]}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^wave-[A-Za-z0-9][A-Za-z0-9._-]*$"}}, "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "acceptance_obligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "merge_evidence": {"type": ["object", "null"], "required": ["policy_version", "evidence_binding", "iaa_reference"], "additionalProperties": false, "properties": {"policy_version": {"type": "string", "minLength": 1}, "evidence_binding": {"$ref": "#/$defs/evidenceBinding"}, "iaa_reference": {"type": "string", "minLength": 1}}}}},
    "event": {"type": "object", "required": ["event_id", "idempotency_key", "sequence", "wave_id", "stage", "event_type", "input_revision", "state_before", "state_after", "decision", "reason", "owner", "envelope_id", "evidence_references", "budget"], "additionalProperties": false, "properties": {"event_id": {"type": "string", "minLength": 1}, "idempotency_key": {"type": "string", "minLength": 1}, "sequence": {"type": "integer", "minimum": 1}, "wave_id": {"type": ["string", "null"], "pattern": "^wave-[A-Za-z0-9][A-Za-z0-9._-]*$"}, "stage": {"enum": ["INTAKE", "DISPATCH", "PRE_BUILD", "PRE_BRIEF", "BUILD", "QP", "ECAP", "GATES", "FINAL_IAA", "REVIEW", "MERGE", "VALIDATION", "JOB_ACCEPTANCE"]}, "event_type": {"type": "string", "minLength": 1}, "input_revision": {"type": "string", "minLength": 1}, "state_before": {"type": "string", "minLength": 1}, "state_after": {"type": "string", "minLength": 1}, "decision": {"enum": ["ACCEPTED", "REJECTED", "NO_OP", "TRIPPED"]}, "reason": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "envelope_id": {"type": "string", "minLength": 1}, "delta_class": {"enum": ["ADMIN_TOKEN_ONLY", "SUBSTANTIVE", "REBASE", "GATE_CHANGE", "UNKNOWN"]}, "evidence_binding": {"$ref": "#/$defs/evidenceBinding"}, "evidence_references": {"type": "array", "items": {"type": "string", "minLength": 1}}, "material_blockers": {"type": "array", "items": {"type": "string"}}, "budget": {"type": "object", "required": ["dispatch_runtime_minutes", "total_runtime_minutes", "material_corrections", "stage_attempts", "merge_attempts", "spend"], "additionalProperties": false, "properties": {"dispatch_runtime_minutes": {"type": "integer", "minimum": 0}, "total_runtime_minutes": {"type": "integer", "minimum": 0}, "material_corrections": {"type": "integer", "minimum": 0}, "stage_attempts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "merge_attempts": {"type": "integer", "minimum": 0}, "spend": {"type": ["number", "null"], "minimum": 0}}}}}
  }
}
